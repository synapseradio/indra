{
  "name": "indra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "INDRA: tools for the creation, composition, sequencing and refinement of agentic expressions.",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/runtime/*"
    ],
    "catalog": {
      "effect": "~3.21.3",
      "xstate": "~5.32.0",
      "@boundaryml/baml": "~0.222.0"
    },
    "catalogs": {
      "tooling": {
        "typescript": "~6.0.3",
        "@rslib/core": "~0.22.1",
        "turbo": "~2.9.18",
        "@biomejs/biome": "~2.5.0",
        "markdownlint-cli2": "~0.22.1",
        "vitest": "~3.2.6",
        "@effect/vitest": "~0.29.0",
        "@types/node": "~25.9.2",
        "vite-tsconfig-paths": "~6.1.1"
      }
    }
  },
  "scripts": {
    "generate": "turbo run generate",
    "build": "turbo run build",
    "check": "turbo run check:types lint:docs && biome check .",
    "check:types": "tsc -b tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "lint:docs": "markdownlint-cli2",
    "lint:docs:fix": "markdownlint-cli2 --fix",
    "format": "biome format --write .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:tooling",
    "@effect/vitest": "catalog:tooling",
    "@rslib/core": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "markdownlint-cli2": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vite-tsconfig-paths": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
