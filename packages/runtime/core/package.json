{
  "name": "@indra/runtime-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./inference-live": {
      "types": "./dist/baml/inference.layer.d.ts",
      "bun": "./src/baml/inference.layer.ts",
      "import": "./dist/baml/inference.layer.js",
      "default": "./dist/baml/inference.layer.js"
    }
  },
  "scripts": {
    "generate": "baml-cli generate --from baml_src",
    "build": "rslib build",
    "check:types": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@indra/runtime-contracts": "workspace:*",
    "effect": "catalog:",
    "@boundaryml/baml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:tooling",
    "@indra/configs": "workspace:*",
    "@rslib/core": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "typescript": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
